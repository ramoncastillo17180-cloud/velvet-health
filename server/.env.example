# PostgreSQL connection string (required by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velvet_health?schema=public"

# Secret used to sign JWT access tokens (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# HTTP port
PORT=3001

# Access token expiry (JWT `expiresIn` value)
JWT_EXPIRES_IN="7d"

# Password reset token TTL, in minutes
RESET_TOKEN_TTL_MINUTES=15

# Email delivery mode: "console" (dev) or "smtp" (production)
EMAIL_MODE="console"

# SMTP configuration (used only when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="no-reply@velvethealth.example"

# Credential document storage: "local" or "s3"
DOCUMENT_STORAGE="local"

# Local upload directory for credential documents (outside the web root)
UPLOAD_DIR="./uploads/documents"

# Maximum upload size, in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# S3-compatible object storage (used only when DOCUMENT_STORAGE=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Admin bootstrap credentials (used by `npm run prisma:seed-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
ADMIN_APELLIDOS=
